import sqlite from "..";
import std;
fn state(db: sqlite::Database, expected: i64, automatic: bool) {
    let actual, code = sqlite::transaction_state(db);
    let auto_mode, auto_code = sqlite::autocommit(db);
    assert(code == sqlite::OK && actual == expected);
    assert(auto_code == sqlite::OK && auto_mode == automatic);
}
fn transaction_states() {
    let options = sqlite::Options { .. };
    let db, opened = sqlite::open(":memory:", options);
    assert(opened == sqlite::OK);
    state(db, sqlite::TXN_NONE, true);
    assert(sqlite::execute(db, "CREATE TABLE t(id INTEGER PRIMARY KEY, payload)") == sqlite::OK);
    assert(sqlite::execute(db, "INSERT INTO t VALUES(1,zeroblob(4)),(2,zeroblob(4))") == sqlite::OK);
    let cursor, prepared = sqlite::prepare(db, "SELECT * FROM t ORDER BY id");
    assert(prepared == sqlite::OK);
    state(db, sqlite::TXN_NONE, true);
    assert(sqlite::step(cursor) == sqlite::ROW);
    state(db, sqlite::TXN_READ, true);
    state(db, sqlite::TXN_READ, true); // Introspection neither steps nor resets.
    let id, id_code = sqlite::column_integer(cursor, 0);
    assert(id_code == sqlite::OK && id == 1);
    assert(sqlite::reset(cursor) == sqlite::OK);
    state(db, sqlite::TXN_NONE, true);
    assert(sqlite::step(cursor) == sqlite::ROW && sqlite::step(cursor) == sqlite::ROW);
    assert(sqlite::step(cursor) == sqlite::DONE);
    state(db, sqlite::TXN_NONE, true);
    assert(sqlite::finalize(cursor) == sqlite::OK);
    assert(sqlite::execute(db, "BEGIN DEFERRED") == sqlite::OK);
    state(db, sqlite::TXN_NONE, false);
    let read, read_code = sqlite::prepare(db, "SELECT * FROM t ORDER BY id");
    assert(read_code == sqlite::OK && sqlite::step(read) == sqlite::ROW);
    assert(sqlite::finalize(read) == sqlite::OK);
    state(db, sqlite::TXN_READ, false);
    assert(sqlite::execute(db, "SAVEPOINT nested") == sqlite::OK);
    assert(sqlite::execute(db, "UPDATE t SET payload=zeroblob(5)") == sqlite::OK);
    state(db, sqlite::TXN_WRITE, false);
    assert(sqlite::execute(db, "ROLLBACK TO nested") == sqlite::OK);
    state(db, sqlite::TXN_WRITE, false);
    assert(sqlite::execute(db, "RELEASE nested") == sqlite::OK);
    assert(sqlite::execute(db, "COMMIT") == sqlite::OK);
    state(db, sqlite::TXN_NONE, true);
    assert(sqlite::execute(db, "BEGIN IMMEDIATE") == sqlite::OK);
    state(db, sqlite::TXN_WRITE, false);
    assert(sqlite::execute(db, "INSERT OR ROLLBACK INTO t VALUES(1,NULL)") > 0);
    state(db, sqlite::TXN_NONE, true);
    let blob, blob_code = sqlite::blob_open(db, "t", "payload", 1, false);
    assert(blob_code == sqlite::OK);
    state(db, sqlite::TXN_READ, true);
    assert(sqlite::blob_close(blob) == sqlite::OK);
    state(db, sqlite::TXN_NONE, true);
    assert(sqlite::execute(db, "BEGIN") == sqlite::OK);
    let writable, write_code = sqlite::blob_open(db, "t", "payload", 1, true);
    assert(write_code == sqlite::OK);
    state(db, sqlite::TXN_WRITE, false);
    assert(sqlite::blob_close(writable) == sqlite::OK);
    assert(sqlite::execute(db, "ROLLBACK") == sqlite::OK);
    state(db, sqlite::TXN_NONE, true);
    assert(sqlite::execute(db, "BEGIN") == sqlite::OK);
    let pending, pending_code = sqlite::prepare(db, "SELECT * FROM t ORDER BY id");
    assert(pending_code == sqlite::OK && sqlite::step(pending) == sqlite::ROW);
    assert(sqlite::execute(db, "COMMIT") == sqlite::OK);
    state(db, sqlite::TXN_READ, true); // A pending cursor can outlive COMMIT.
    assert(sqlite::finalize(pending) == sqlite::OK);
    state(db, sqlite::TXN_NONE, true);
    // TEMP activity is outside the main-schema state.
    assert(sqlite::execute(db, "CREATE TEMP TABLE scratch(x)") == sqlite::OK);
    assert(sqlite::execute(db, "BEGIN") == sqlite::OK);
    assert(sqlite::execute(db, "INSERT INTO scratch VALUES(1)") == sqlite::OK);
    state(db, sqlite::TXN_NONE, false);
    assert(sqlite::execute(db, "ROLLBACK") == sqlite::OK);
    assert(sqlite::close(db) == sqlite::OK);
    let missing, missing_code = sqlite::transaction_state(db);
    assert(missing == 0 && missing_code == sqlite::INVALID_HANDLE);
    let empty = sqlite::Database { .. };
    let invalid, invalid_code = sqlite::transaction_state(empty);
    assert(invalid == 0 && invalid_code == sqlite::INVALID_HANDLE);
}
fn main() {
    transaction_states();
    let options = sqlite::Options { .. };
    let db, code = sqlite::open(":memory:", options);
    assert(code == sqlite::OK);
    let stmt, prepared = sqlite::prepare(db, "SELECT ?5 AS same, :name AS same, :name, @name, $name");
    assert(prepared == sqlite::OK && sqlite::parameter_count(stmt) == 8);
    assert(sqlite::parameter_index(stmt, "?5") == 5);
    assert(sqlite::parameter_index(stmt, ":name") == 6);
    assert(sqlite::parameter_index(stmt, "@name") == 7);
    assert(sqlite::parameter_index(stmt, "$name") == 8);
    assert(sqlite::parameter_index(stmt, ":missing") == 0);
    for bad in ["", "name", ":na\x00me"] { assert(sqlite::parameter_index(stmt, bad) == sqlite::INVALID_INPUT); }
    var name: u8[>..] = [];
    assert(sqlite::column_name(stmt, 0, name) == sqlite::OK && name == "same");
    assert(sqlite::column_name(stmt, 1, name) == sqlite::OK && name == "same");
    assert(sqlite::bind_text(stmt, sqlite::parameter_index(stmt, ":name"), "owned") == sqlite::OK);
    assert(sqlite::step(stmt) == sqlite::ROW);
    assert(sqlite::column_name(stmt, 1, name) == sqlite::OK && name == "same");
    assert(sqlite::step(stmt) == sqlite::DONE);
    assert(sqlite::column_name(stmt, 0, name) == sqlite::OK && name == "same");
    assert(sqlite::reset(stmt) == sqlite::OK);
    assert(sqlite::column_name(stmt, 99, name) == sqlite::INVALID_INPUT && name.len == 0);
    assert(sqlite::finalize(stmt) == sqlite::OK);
    assert(sqlite::parameter_count(stmt) == sqlite::INVALID_HANDLE);
    assert(sqlite::parameter_index(stmt, ":name") == sqlite::INVALID_HANDLE);
    assert(sqlite::column_name(stmt, 0, name) == sqlite::INVALID_HANDLE && name.len == 0);
    var alias: u8[>..] = []; alias.resize(1024, 'a');
    let sql = str("SELECT 1 AS ", alias);
    let large, large_code = sqlite::prepare(db, sql);
    assert(large_code == sqlite::OK);
    assert(sqlite::column_name(large, 0, name) == sqlite::OK && name == alias);
    assert(sqlite::finalize(large) == sqlite::OK && name == alias);
    assert(sqlite::execute(db, "CREATE TABLE t(id INTEGER PRIMARY KEY, value)") == sqlite::OK);
    let initial, initial_code = sqlite::autocommit(db);
    assert(initial_code == sqlite::OK && initial);
    assert(sqlite::execute(db, "BEGIN") == sqlite::OK);
    let in_txn, tx_code = sqlite::autocommit(db);
    assert(tx_code == sqlite::OK && !in_txn);
    assert(sqlite::execute(db, "INSERT INTO t VALUES(-42, 'a')") == sqlite::OK);
    let rowid, rowid_code = sqlite::last_insert_rowid(db);
    let changed, changed_code = sqlite::changes(db);
    assert(rowid_code == sqlite::OK && rowid == -42 && changed_code == sqlite::OK && changed == 1);
    assert(sqlite::execute(db, "SAVEPOINT nested") == sqlite::OK);
    assert(sqlite::execute(db, "INSERT INTO t VALUES(7, 'b')") == sqlite::OK);
    assert(sqlite::execute(db, "ROLLBACK TO nested") == sqlite::OK);
    let rolled_id, rolled_code = sqlite::last_insert_rowid(db);
    assert(rolled_code == sqlite::OK && rolled_id == 7);
    assert(sqlite::execute(db, "RELEASE nested") == sqlite::OK);
    assert(sqlite::execute(db, "COMMIT") == sqlite::OK);
    let committed, commit_code = sqlite::autocommit(db);
    assert(commit_code == sqlite::OK && committed);
    assert(sqlite::execute(db, "CREATE TABLE log(x)") == sqlite::OK);
    assert(sqlite::execute(db, "CREATE TRIGGER audit AFTER INSERT ON t BEGIN INSERT INTO log VALUES(new.id); END") == sqlite::OK);
    assert(sqlite::execute(db, "INSERT INTO t VALUES(11, 'c')") == sqlite::OK);
    let direct, direct_code = sqlite::changes(db);
    assert(direct_code == sqlite::OK && direct == 1);
    assert(sqlite::execute(db, "CREATE TABLE noid(k PRIMARY KEY) WITHOUT ROWID") == sqlite::OK);
    assert(sqlite::execute(db, "INSERT INTO noid VALUES(1)") == sqlite::OK);
    let preserved, preserved_code = sqlite::last_insert_rowid(db);
    assert(preserved_code == sqlite::OK && preserved == 11);
    assert(sqlite::execute(db, "BEGIN") == sqlite::OK);
    assert(sqlite::execute(db, "INSERT INTO t VALUES(11, 'duplicate')") > 0);
    let retained, retained_code = sqlite::autocommit(db);
    assert(retained_code == sqlite::OK && !retained);
    assert(sqlite::execute(db, "INSERT OR ROLLBACK INTO t VALUES(11, 'duplicate')") > 0);
    let recovered, recovered_code = sqlite::autocommit(db);
    assert(recovered_code == sqlite::OK && recovered);
    var long_key: u8[>..] = []; long_key.append(":"); long_key.resize(1024, 'a');
    let long_sql = str("SELECT ", long_key, " AS \"\"");
    let key_stmt, key_code = sqlite::prepare(db, long_sql);
    assert(key_code == sqlite::OK && sqlite::parameter_index(key_stmt, long_key) == 1);
    assert(sqlite::column_name(key_stmt, 0, name) == sqlite::OK && name.len == 0);
    long_key.push('a');
    assert(sqlite::parameter_index(key_stmt, long_key) == sqlite::INVALID_INPUT);
    assert(sqlite::finalize(key_stmt) == sqlite::OK);
    assert(sqlite::close(db) == sqlite::OK);
    let stale, stale_code = sqlite::last_insert_rowid(db);
    assert(stale == 0 && stale_code == sqlite::INVALID_HANDLE);
    let invalid, invalid_code = sqlite::autocommit(db);
    assert(!invalid && invalid_code == sqlite::INVALID_HANDLE);
    print("sqlite metadata/status tests passed");
}
