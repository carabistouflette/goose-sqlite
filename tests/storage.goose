import sqlite from "..";
import std;
fn main() {
    let opts = sqlite::Options { .. };
    let db, opened = sqlite::open(":memory:", opts);
    let dest, dest_opened = sqlite::open(":memory:", opts);
    assert(opened == sqlite::OK && dest_opened == sqlite::OK);
    assert(sqlite::execute(db, "CREATE TABLE t(id INTEGER PRIMARY KEY, x BLOB, y)") == sqlite::OK);
    assert(sqlite::execute(db, "INSERT INTO t VALUES(-7, zeroblob(8192), 0)") == sqlite::OK);
    let invalid, invalid_code = sqlite::blob_open(db, "t", "x", -7, true);
    assert(invalid_code == sqlite::INVALID_STATE && invalid.token == 0);
    assert(sqlite::execute(db, "BEGIN") == sqlite::OK);
    let blob, blob_code = sqlite::blob_open(db, "t", "x", -7, true);
    assert(blob_code == sqlite::OK);
    let size, sized = sqlite::blob_size(blob);
    assert(sized == sqlite::OK && size == 8192);
    assert(sqlite::blob_write(blob, 8190, "ab") == sqlite::OK);
    assert(sqlite::blob_write(blob, 8191, "ab") == sqlite::INVALID_INPUT);
    var out: u8[>..] = [];
    assert(sqlite::blob_read(blob, 8190, 2, out) == sqlite::OK && out == "ab");
    assert(sqlite::blob_read(blob, 8192, 0, out) == sqlite::OK && out.len == 0);
    assert(sqlite::blob_read(blob, 9223372036854775807, 2, out) == sqlite::INVALID_INPUT && out.len == 0);
    assert(sqlite::blob_read(blob, 0, 1048577, out) == sqlite::INVALID_INPUT && out.len == 0);
    assert(sqlite::close(db) == 5);
    assert(sqlite::execute(db, "COMMIT") == 5);
    assert(sqlite::blob_close(blob) == sqlite::OK && sqlite::blob_close(blob) == sqlite::INVALID_HANDLE);
    assert(sqlite::blob_read(blob, 0, 1, out) == sqlite::INVALID_HANDLE && out.len == 0);
    assert(sqlite::execute(db, "COMMIT") == sqlite::OK);
    let reader, read_code = sqlite::blob_open(db, "t", "x", -7, false);
    assert(read_code == sqlite::OK);
    assert((sqlite::blob_write(reader, 0, "z") & 255) == 8);
    assert((sqlite::blob_write(reader, 0, "") & 255) == 8);
    assert(sqlite::execute(db, "UPDATE t SET y=1 WHERE id=-7") == sqlite::OK);
    assert((sqlite::blob_read(reader, 0, 1, out) & 255) == 4 && out.len == 0);
    let expired, expired_code = sqlite::blob_size(reader);
    assert(expired == 0 && (expired_code & 255) == 4);
    let closed = sqlite::blob_close(reader);
    assert(closed == sqlite::OK || (closed & 255) == 4);
    assert(sqlite::execute(db, "BEGIN") == sqlite::OK);
    let rolled, rolled_code = sqlite::blob_open(db, "t", "x", -7, true);
    assert(rolled_code == sqlite::OK && sqlite::execute(db, "ROLLBACK") == sqlite::OK);
    assert((sqlite::blob_read(rolled, 0, 0, out) & 255) == 4 && out.len == 0);
    assert((sqlite::blob_close(rolled) & 255) == 4);
    assert(sqlite::blob_close(rolled) == sqlite::INVALID_HANDLE);
    assert(sqlite::execute(dest, "CREATE TABLE old(x)") == sqlite::OK);
    assert(sqlite::execute(dest, "INSERT INTO old VALUES(42)") == sqlite::OK);
    assert(sqlite::backup(db, dest, 1) == sqlite::LIMIT);
    let old, old_code = sqlite::prepare(dest, "SELECT x FROM old");
    assert(old_code == sqlite::OK && sqlite::step(old) == sqlite::ROW);
    let value, value_code = sqlite::column_integer(old, 0);
    assert(value_code == sqlite::OK && value == 42);
    assert(sqlite::backup(db, dest, 100) == sqlite::INVALID_STATE);
    assert(sqlite::finalize(old) == sqlite::OK);
    assert(sqlite::backup(db, dest, 100) == sqlite::OK);
    let copy, copy_code = sqlite::blob_open(dest, "t", "x", -7, false);
    assert(copy_code == sqlite::OK && sqlite::blob_read(copy, 8190, 2, out) == sqlite::OK && out == "ab");
    assert(sqlite::blob_close(copy) == sqlite::OK);
    assert(sqlite::backup(db, db, 100) == sqlite::INVALID_INPUT);
    assert(sqlite::execute(db, "BEGIN IMMEDIATE") == sqlite::OK);
    assert(sqlite::backup(db, dest, 100) == sqlite::INVALID_STATE);
    assert(sqlite::execute(db, "ROLLBACK") == sqlite::OK);
    assert(sqlite::close(db) == sqlite::OK && sqlite::close(dest) == sqlite::OK);
    assert(sqlite::backup(db, dest, 100) == sqlite::INVALID_HANDLE);
    print("sqlite storage tests passed");
}
